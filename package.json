{
  "name": "react-combo-provider",
  "version": "1.0.20",
  "description": "Tiny (~0.7 kB minzipped) zero-dependency function that generates a typed React Context Provider and hooks in one call. Each hook gets its own Context, so components re-render only for the data they use",
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.mjs",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsup",
    "build/watch": "tsup --watch",
    "whats_there": "npm pack && tar -xvzf *.tgz && rm -rf package *.tgz",
    "lint": "biome check ./src",
    "lint:fix": "biome format --write ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roman86/react-combo-provider.git"
  },
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "context",
    "react-context",
    "usecontext",
    "provider",
    "store",
    "state",
    "state-management",
    "slice",
    "scoped",
    "typescript",
    "type-safe",
    "rerender",
    "performance"
  ],
  "author": "Roman Kozodoi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Roman86/react-combo-provider/issues"
  },
  "homepage": "https://github.com/Roman86/react-combo-provider#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/react": "18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "glob": "^11.1.0"
  }
}
